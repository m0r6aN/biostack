{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/contracts/**/*.json",
    "src/fixtures/**/*.json",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/middleware.ts",
    "src/styles/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/dev",
    "src/__tests__",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
