# BioStack — Environment Variables Reference
# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION: Copy to .env, fill every "Required" value, NEVER commit .env
# DEVELOPMENT: appsettings.Development.json supplies local-only SQLite, URLs,
#              and a non-production JWT placeholder. Environment variables
#              override those defaults when a developer needs custom values.
#              Leave Smtp__Host blank to use the in-memory magic link inbox.
#
# WARNING — inline comments are NOT safe on value lines below. Some env-file
# loaders (docker --env-file, docker-compose env_file:, etc.) do not strip a
# trailing "# comment"; it becomes part of the literal value, so a line like
# `Smtp__Host=   # leave blank in dev` can silently set Smtp__Host to the
# comment text itself instead of leaving it blank. Keep every value below bare
# and trimmed — put explanations on their own comment line ABOVE the setting,
# never after the `=` on the same line.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=                          # Required (prod). Strong random password for PostgreSQL.
                                      # Dev default handled in docker-compose.dev.yml.

# ── Backend runtime ───────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production     # Production | Development
ASPNETCORE_URLS=http://+:5000

# Production: postgres connection string (required when ASPNETCORE_ENVIRONMENT=Production)
# ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=biostack;Username=biostack;Password=<DB_PASSWORD>
# Dev SQLite fallback (appsettings.Development.json and docker-compose.dev.yml):
# ConnectionStrings__DefaultConnection=Data Source=/app/data/biostack.db

# ── Secrets — REQUIRED IN PRODUCTION ─────────────────────────────────────────
# Generate each with: openssl rand -hex 32
Jwt__Secret=                          # Required. Min 32 chars. Signs JWT bearer tokens.
Auth__CallbackSecret=                 # Required. Shared secret between API ↔ frontend.
                                      # Must match AUTH_CALLBACK_SECRET in frontend vars.

Jwt__Issuer=biostack
Jwt__Audience=biostack-ui
Jwt__ExpiryMinutes=60

# ── Public URLs ───────────────────────────────────────────────────────────────
PublicApiUrl=https://api.yourdomain.com   # Production API base URL
FrontendUrl=https://yourdomain.com        # Production frontend base URL
Cors__AllowedOrigins__0=https://yourdomain.com  # Required (prod). Must include FrontendUrl origin.
# Dev: PublicApiUrl=http://localhost:5000 / FrontendUrl=http://localhost:3043

# ── Passkeys / WebAuthn (preferred returning-user sign-in) ───────────────────
# Fail-closed by default. Enable only after HTTPS, public origin, and RP ID are final.
Auth__Passkeys__Enabled=false
Auth__Passkeys__RpId=yourdomain.com             # Hostname only; no scheme, path, port, or wildcard.
Auth__Passkeys__ServerName=BioStack
Auth__Passkeys__Origins__0=https://yourdomain.com # Exact origin; must include FrontendUrl in production.

# ── Email delivery (choose Option A or B; leave both blank for dev inbox) ────
# Option A: SMTP. Leave Smtp__Host bare/blank below to use the dev inbox.
# Example value: Smtp__Host=smtp.sendgrid.net
Smtp__Host=
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=
Smtp__Password=
Smtp__FromEmail=noreply@yourdomain.com
Smtp__FromName=BioStack
Smtp__MagicLinkSubject=BioStack Quick Login

# Option B: Azure Communication Services Email (takes priority over SMTP when set)
# AzureCommunicationEmail__ConnectionString=
# AzureCommunicationEmail__SenderAddress=DoNotReply@your-verified-domain.example

# ── Frontend (NextAuth v5) ────────────────────────────────────────────────────
# These go into frontend/.env.local (or Docker build args / container env)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
API_INTERNAL_URL=http://biostack-api:5000   # Internal Docker network — no change needed
AUTH_SECRET=                          # Required. Min 32 chars. Generate: openssl rand -hex 32
AUTH_URL=https://yourdomain.com       # Required. Public frontend URL.
AUTH_TRUST_HOST=true
AUTH_CALLBACK_SECRET=                 # Required. Must match Auth__CallbackSecret above.

# ── OAuth providers (all optional — leave blank to disable) ──────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=

# ── Stripe (REQUIRED IN PRODUCTION while paid plans are advertised) ──────────
# Use live-mode values only after product/price approval. Never reuse test-mode
# IDs or webhook signing secrets in production.
Stripe__SecretKey=                    # Required (prod). Stripe live restricted/secret key.
Stripe__WebhookSecret=                # Required (prod). Signing secret for the exact production endpoint.
Stripe__OperatorPriceId=              # Required (prod). Approved $12 USD monthly recurring price.
Stripe__CommanderPriceId=             # Required (prod). Approved $29 USD monthly recurring price.
Stripe__CheckoutSuccessUrl=https://yourdomain.com/billing?checkout=success
Stripe__CheckoutCancelUrl=https://yourdomain.com/billing?checkout=cancelled
Stripe__PortalReturnUrl=https://yourdomain.com/billing

# ── Keon Runtime (required for live governance receipts in production) ───────
# PR-PROV-001: docker-compose.yml passes these through to biostack-api with safe defaults.
# Leaving them blank keeps the app in fail-closed stub mode; KeonRuntime__LiveMode is NOT
# operator-settable through this file (fixed false in docker-compose.yml) — see
# docs/INITIATIVES/biostack-production-readiness/evidence/PR-PROV-001-deployment-config-review.md.
# In a Production environment, leaving these blank makes the API fail to start unless
# KeonRuntime__AllowStubInProduction=true is explicitly set elsewhere (acknowledging
# ungoverned operation). Supplying real values here is GATED-1 (owner: Clint Morgan) —
# do not fill these with a live base URL or bearer token outside that owner's authorized change.
KEON_RUNTIME_BASE_URL=
KEON_RUNTIME_BEARER_TOKEN=
KEON_RUNTIME_TIMEOUT_MS=5000

# ── Redis (optional — falls back to in-memory cache) ─────────────────────────
# Redis__Configuration=your-redis-host:6379
# Redis__InstanceName=biostack:

# ── Knowledge worker (one-shot seeding job) ───────────────────────────────────
Worker__RunMode=Seed                  # Seed | Analyze | Both
Worker__DryRun=false
Worker__MaxBatchSize=50

# ── Docker / Hot Reload (dev-only) ───────────────────────────────────────────
# CHOKIDAR_USEPOLLING=true
# WATCHPACK_POLLING=true
# DOTNET_USE_POLLING_FILE_WATCHER=1
