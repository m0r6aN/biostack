{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biostack.cc/schemas/review-decision.schema.json",
  "title": "BioStack Research Review Decision Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "batch", "decisions"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "recordType": { "type": "string", "const": "review-decision-batch" },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batchId", "reviewerId", "reviewedAt", "notes"],
      "properties": {
        "batchId": { "type": "string", "minLength": 1 },
        "reviewerId": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "notes": { "$ref": "#/$defs/stringArray" }
      }
    },
    "decisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decision" } }
  },
  "$defs": {
    "stringArray": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "displayBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["surface", "claimId", "claimSha256", "sourceItemId", "sourceRecordId", "sourceSnapshotSha256", "observationReceiptSha256", "payloadSha256"],
      "properties": {
        "surface": { "const": "knowledge-card-study-design" },
        "claimId": { "type": "string", "minLength": 1, "pattern": "^[^*]+$" },
        "sourceItemId": { "type": "string", "minLength": 1, "pattern": "^[^*]+$" },
        "sourceRecordId": { "type": "string", "pattern": "^[0-9]+$" },
        "claimSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceSnapshotSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "observationReceiptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "payloadSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "compoundName", "decision", "reviewerId", "reviewedAt", "scope", "notes"],
      "allOf": [{
        "if": { "properties": { "scope": { "required": ["displayBindings"] } } },
        "then": { "properties": {
          "decision": { "const": "approve-claims" },
          "clearsSoftPromotionBlockers": { "const": false },
          "scope": { "properties": { "claimIds": { "minItems": 1, "maxItems": 1 } } }
        } }
      }],
      "properties": {
        "decisionId": { "type": "string", "minLength": 1 },
        "compoundName": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "enum": ["approve-for-promotion", "approve-claims", "resolve-review-items", "archive-draft", "request-changes", "reject", "escalate-to-owner"] },
        "reviewerId": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claimIds", "qualityFlags", "reviewCategories", "promotionBlockers"],
          "properties": {
            "claimIds": { "$ref": "#/$defs/stringArray" },
            "reviewQueueItemIds": { "$ref": "#/$defs/stringArray" },
            "qualityFlags": { "$ref": "#/$defs/stringArray" },
            "reviewCategories": { "$ref": "#/$defs/stringArray" },
            "promotionBlockers": { "$ref": "#/$defs/stringArray" },
            "remediationPlanItemIds": { "$ref": "#/$defs/stringArray" },
            "remediationResolutionTypes": { "$ref": "#/$defs/stringArray" },
            "displayBindings": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/displayBinding" } }
          }
        },
        "clearsSoftPromotionBlockers": { "type": "boolean", "default": false },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" },
        "notes": { "$ref": "#/$defs/stringArray" },
        "council": { "$ref": "#/$defs/council" }
      }
    },
    "council": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "reviewers", "ownerOptions", "legalRisks"],
      "properties": {
        "outcome": { "enum": ["consensus", "escalated-to-owner"] },
        "reviewers": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["reviewerId", "provider", "model", "decision", "proposedTier", "rationale"],
            "properties": {
              "reviewerId": { "type": "string", "minLength": 1 },
              "provider": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "decision": { "enum": ["approve", "request-changes", "reject"] },
              "proposedTier": { "enum": ["Established", "Plausible Theory", "Early Evidence", "Anecdotal Signal", "Contradicted", "Unsupported", "Hype Exceeds Evidence", "Not graded"] },
              "rationale": { "type": "string" }
            }
          }
        },
        "ownerOptions": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["optionId", "summary", "decision", "basis"],
            "properties": {
              "optionId": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "decision": { "enum": ["approve-for-promotion", "request-changes", "reject"] },
              "proposedTier": { "type": ["string", "null"] },
              "basis": { "type": "string" }
            }
          }
        },
        "legalRisks": { "$ref": "#/$defs/stringArray" },
        "claims": {
          "description": "Claim-level sign-off on evidence.publicClaims (growth spec Phase 1). Consensus approve at the claim's tier publishes it.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claimId", "currentTier", "outcome", "decision", "tier", "reviewers", "ownerOptions"],
            "properties": {
              "claimId": { "type": "string", "minLength": 1 },
              "currentTier": { "type": "string" },
              "outcome": { "enum": ["consensus", "escalated-to-owner", "incomplete"] },
              "decision": { "enum": ["approve", "request-changes", "reject", null] },
              "tier": { "enum": ["Established", "Plausible Theory", "Early Evidence", "Anecdotal Signal", "Contradicted", "Unsupported", "Hype Exceeds Evidence", "Not graded", null] },
              "reviewers": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["reviewerId", "provider", "model", "decision", "proposedTier", "rationale"],
                  "properties": {
                    "reviewerId": { "type": "string", "minLength": 1 },
                    "provider": { "type": "string", "minLength": 1 },
                    "model": { "type": "string", "minLength": 1 },
                    "decision": { "enum": ["approve", "request-changes", "reject", null] },
                    "proposedTier": { "enum": ["Established", "Plausible Theory", "Early Evidence", "Anecdotal Signal", "Contradicted", "Unsupported", "Hype Exceeds Evidence", "Not graded", null] },
                    "rationale": { "type": "string" }
                  }
                }
              },
              "ownerOptions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["optionId", "summary", "decision", "basis"],
                  "properties": {
                    "optionId": { "type": "string", "minLength": 1 },
                    "summary": { "type": "string", "minLength": 1 },
                    "decision": { "enum": ["approve-for-promotion", "request-changes", "reject"] },
                    "proposedTier": { "type": ["string", "null"] },
                    "basis": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}